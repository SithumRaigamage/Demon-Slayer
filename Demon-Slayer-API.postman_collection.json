{
	"info": {
		"_postman_id": "demon-slayer-api-collection",
		"name": "Demon Slayer API",
		"description": "Collection of API endpoints for the Demon Slayer fan website. This collection includes endpoints for fetching characters, combat styles, and other related data from the Demon Slayer API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://www.demonslayer-api.com/api/v1",
			"type": "string"
		},
		{
			"key": "defaultLimit",
			"value": "45",
			"type": "string"
		},
		{
			"key": "defaultPage",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Characters",
			"item": [
				{
					"name": "Get All Characters",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/characters?limit={{defaultLimit}}&page={{defaultPage}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters"
							],
							"query": [
								{
									"key": "limit",
									"value": "{{defaultLimit}}",
									"description": "Number of characters to return per page"
								},
								{
									"key": "page",
									"value": "{{defaultPage}}",
									"description": "Page number for pagination"
								}
							]
						},
						"description": "Fetches a paginated list of all Demon Slayer characters including their name, race, image, and other details."
					},
					"response": []
				},
				{
					"name": "Get Characters (Limited)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/characters?limit=10&page=1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters"
							],
							"query": [
								{
									"key": "limit",
									"value": "10",
									"description": "Limit to 10 characters"
								},
								{
									"key": "page",
									"value": "1",
									"description": "First page"
								}
							]
						},
						"description": "Fetches a smaller set of characters (10) for testing purposes."
					},
					"response": []
				},
				{
					"name": "Get Character by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/characters/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"characters",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "Character ID"
								}
							]
						},
						"description": "Fetches details for a specific character by their ID."
					},
					"response": []
				}
			],
			"description": "Endpoints related to Demon Slayer characters (Demon Slayers, Demons, Hashira, etc.)"
		},
