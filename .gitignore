# ================================
# Demon Slayer Project - .gitignore
# ================================

# ----- OS Generated Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/

# ----- SonarQube -----
.scannerwork/

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ----- Build Output -----
dist/
build/
out/
*.min.js
*.min.css
*.map

# ----- Environment Variables -----
.env
.env.local
.env.*.local
*.env

# ----- Logs -----
logs/
*.log

# ----- Temporary Files -----
tmp/
temp/
*.tmp
*.temp
*.bak
*.cache

# ----- Coverage Reports -----
coverage/
.nyc_output/
*.lcov

# ----- Media (optional - uncomment if you don't want to track large files) -----
# *.mp3
# *.mov
# *.mp4
# *.avi
# *.mkv

# ----- Compiled Files -----
*.class
*.dll
*.exe
*.o
*.so

# ----- Archives -----
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ----- Secrets & Credentials -----
*.pem
*.key
*_rsa
*_rsa.*
*_dsa
*_dsa.*
*_ed25519
*_ed25519.*
*.p12
secrets.json
credentials.json
